# Copy to .env and fill in.
#
# You need NONE of these to see the pipeline work:  npm run job:dry

# ─── Google Sheet: the list of videos being tracked ──────────────────────────
# The id from the sheet's URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# The sheet must have a tab named "Tracked" with this header row:
#   video_url | campaign | creator | added_by | notes
SHEET_ID=

# The WHOLE service-account key file, on ONE line.
#   Google Cloud Console > IAM & Admin > Service Accounts > Keys > Add key (JSON)
# The downloaded file is pretty-printed and cannot be pasted here as-is. Do one:
#   jq -c . key.json        # minify to a single line
#   base64 -w0 key.json     # base64 — also accepted
# Then share the Sheet with the service account's client_email as a Viewer,
# or every request 403s with a message that does not mention sharing.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── YouTube Data API v3 ─────────────────────────────────────────────────────
#   Google Cloud Console > APIs & Services > enable "YouTube Data API v3"
#   > Credentials > Create credentials > API key
YOUTUBE_API_KEY=

# ─── MongoDB: snapshot history ───────────────────────────────────────────────
# The Atlas free tier is more than enough: https://www.mongodb.com/cloud/atlas
MONGO_URI=
MONGO_DB=campaign_tracker

# ─── Discord: where the report is posted ─────────────────────────────────────
#   Channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# ─── OpenAI: OPTIONAL ────────────────────────────────────────────────────────
# Without this the digest is written from a template and everything else is
# identical. The numbers never come from the model. See src/digest.ts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
