# Copy to .env and fill in.
#
# You need NONE of these to see the pipeline work:  npm run job:dry

# ─── Schedule ────────────────────────────────────────────────────────────────
# Which calendar day a run is recorded against, and the timezone the report is
# dated in. Any IANA zone name -- Asia/Manila, Europe/Berlin, America/New_York.
# Abbreviations like PHT or EST are NOT valid. Defaults to Asia/Manila.
#
# This does NOT control what time the job fires. GitHub parses the cron
# schedule before any environment exists, so the firing time lives in
# .github/workflows/daily.yml -- that file has a conversion table.
TIMEZONE=Asia/Manila

# ─── Google Sheet: the list of videos being tracked ──────────────────────────
# The id from the sheet's URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# The sheet must have a tab named "Tracked" with this header row:
#   video_url | campaign | creator | added_by | notes
SHEET_ID=

# The service-account key. Locally, just point at the file -- `~` is expanded.
GOOGLE_SERVICE_ACCOUNT_FILE=~/.config/campaign-tracker/service-account.json

# GitHub Actions has no file to point at, so it sets this instead: the entire
# contents of the .json key file (base64 of the file is also accepted). Leave
# it empty locally -- if both are set, the file wins.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── YouTube Data API v3 ─────────────────────────────────────────────────────
#   Google Cloud Console > APIs & Services > enable "YouTube Data API v3"
#   > Credentials > Create credentials > API key
YOUTUBE_API_KEY=

# ─── MongoDB: snapshot history ───────────────────────────────────────────────
# The Atlas free tier is more than enough: https://www.mongodb.com/cloud/atlas
MONGO_URI=
# A name you choose, NOT something you copy from Atlas. MongoDB creates the
# database on first write, so it won't exist until the job has run once.
MONGO_DB=campaign_tracker

# ─── Discord: where the report is posted ─────────────────────────────────────
#   Channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# ─── OpenAI: OPTIONAL ────────────────────────────────────────────────────────
# Without this the digest is written from a template and everything else is
# identical. The numbers never come from the model. See src/digest.ts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
