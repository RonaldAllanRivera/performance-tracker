{
  "name": "campaign-video-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Daily digest of creator video performance across campaigns, posted to Discord.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "job": "tsx src/job.ts",
    "job:dry": "tsx src/job.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.5.0",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
